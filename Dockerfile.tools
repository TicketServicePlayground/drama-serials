# Node + ffmpeg for the content scripts (import-sheet, publish-images, og-images) on the server,
# run by scripts/sync-sheet.sh with the source tree mounted at /src. node_modules sit at the
# root, so ESM imports from /src/scripts resolve to them by walking up the directories.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund && rm package.json package-lock.json
WORKDIR /src
