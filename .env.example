# /opt/drama-serials/.env on the server. deploy.sh creates DB_PASSWORD and JWT_SECRET once.
DB_PASSWORD=
JWT_SECRET=
PUBLIC_SITE_URL=https://affinet.link
# QRIS goes through Xendit, CREDIT_CARD through DOKU.
PAYMENT_METHODS=QRIS,CREDIT_CARD,SBP
# SBP through IXPAY (business unit Eventstripe, credited in IDR)
IXPAY_API_KEY=
IXPAY_BUSINESS_UNIT_ID=
# Prices (rupiah): VIP launch price until LAUNCH_ENDS_AT (first moment of regular prices), then REGULAR_*.
PRICE_EPISODE_IDR=10000
PRICE_SERIES_DAY_IDR=12800
PRICE_WEEK_IDR=29800
PRICE_MONTH_IDR=79800
PRICE_YEAR_IDR=449000
REGULAR_WEEK_IDR=129000
REGULAR_MONTH_IDR=349000
REGULAR_YEAR_IDR=1999000
LAUNCH_ENDS_AT=2027-01-01T00:00:00+07:00
LAUNCH_DISCOUNT_PERCENT=77
SERIES_PASS_HOURS=24
# Episodes 1..N of every series are free.
FREE_EPISODES=7
# Eventstripe's accounts: system_config xendit.api.key / xendit.api.webhook_verif_token.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# Eventstripe's accounts: system_config doku.api.url / doku.client_id / doku.secret_key.
DOKU_API_URL=https://api.doku.com
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Read-only role drama_ro on the Eventstripe database (payment_events, xendit_webhook_logs).
EVENTSTRIPE_DB_DSN=postgresql://drama_ro:<password>@31.97.222.209:5432/albus
# Episode videos: private R2 bucket, layout video/<slug>/<n>.mp4. Read-only key is enough here.
MEDIA_BUCKET=an-serials-media
MEDIA_PREFIX=video/
MEDIA_R2_ACCOUNT_ID=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
# Team notifications in Telegram (sign-ups, payment attempts, outcomes); empty = off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Visit stats page https://affinet.link/stats/<STATS_KEY>; deploy.sh generates it once.
STATS_KEY=
# Team / test accounts, comma-separated emails: left out of the stats
TEST_EMAILS=
# Meta Pixel for the site (Events Manager → data source id); empty = off.
META_PIXEL_ID=

# Reminder emails before a one-series pass ends (empty host = off)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AN Serials <noreply@affinet.link>
REMINDER_HOURS=6,1
